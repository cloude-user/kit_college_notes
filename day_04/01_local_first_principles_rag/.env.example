# ==============================================================================
# KIT College · Day 04: Environment Configuration & API Keys
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env':
#      cp .env.example .env     (or in PowerShell: copy .env.example .env)
# 2. Paste your Google AI Studio API key below:
#      https://aistudio.google.com/
# ==============================================================================

# Google Gemini API Key (Powers Gemini 3.7 Flash, 3.6 Flash, and text-embedding-004)
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini Model ID (options: gemini-3.7-flash, gemini-3.6-flash, gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.7-flash

# Optional: Set to 'true' if running strictly offline without external API calls
OFFLINE_MODE=false
