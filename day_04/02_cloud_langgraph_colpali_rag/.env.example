# ==============================================================================
# AWS CLOUD CREDENTIALS & REGION
# ==============================================================================
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_DEFAULT_REGION=us-east-1
# (Optional: AWS Session Token for temporary IAM/STS assumed role credentials)
# AWS_SESSION_TOKEN=

# ==============================================================================
# CLOUD VECTOR DATABASE PROVIDER (Select "aws_opensearch", "aws_pgvector", or "auto")
# ==============================================================================
CLOUD_VECTOR_STORE_PROVIDER=auto

# OPTION A: Amazon OpenSearch Serverless (AOSS)
# AOSS_ENDPOINT=https://your-collection-id.us-east-1.aoss.amazonaws.com
# AOSS_INDEX_NAME=aurabio-abx702-colpali

# OPTION B: AWS RDS PostgreSQL with pgvector (Cost-Optimal: ~$15/mo or Free Tier)
# PGVECTOR_CONNECTION_STRING=postgresql+psycopg2://admin:yourpassword@your-rds-host.amazonaws.com:5432/clinical_rag_db

# OPTION C: Pinecone Serverless (AWS us-east-1)
# PINECONE_API_KEY=your_pinecone_api_key_here
# PINECONE_INDEX_NAME=aurabio-clinical-rag

# ==============================================================================
# FOUNDATION MODELS & LLM INFERENCE
# ==============================================================================
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ==============================================================================
# COLPALI MODEL SETTINGS
# ==============================================================================
COLPALI_MODEL_NAME=vidore/colpali-v1.2
USE_CUDA=0
